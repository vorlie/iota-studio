---
import BaseLayout from './BaseLayout.astro';
import { DOCS_NAV } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const activeIndex = DOCS_NAV.findIndex((item) => withBase(item.href) === currentPath);
const prevDoc = activeIndex > 0 ? DOCS_NAV[activeIndex - 1] : null;
const nextDoc = activeIndex >= 0 && activeIndex < DOCS_NAV.length - 1 ? DOCS_NAV[activeIndex + 1] : null;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-[240px_1fr]">
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <div class="rounded-xl border border-slate-800/90 bg-slate-900/50 p-3">
          <div class="px-2 pb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
            Documentation
          </div>
          <nav aria-label="Documentation" class="flex flex-col gap-1">
            {
              DOCS_NAV.map((item) => {
                const active = withBase(item.href) === currentPath;
                return (
                  <a
                    href={withBase(item.href)}
                    class:list={[
                      'rounded-lg px-3 py-2 text-sm transition-colors',
                      active
                        ? 'bg-cyan-500/15 font-medium text-cyan-300 ring-1 ring-cyan-400/25'
                        : 'text-slate-300 hover:bg-slate-800/70 hover:text-white',
                    ]}
                  >
                    {item.title}
                  </a>
                );
              })
            }
          </nav>
          <div class="mt-3 border-t border-slate-800/80 pt-3">
            <a
              href={withBase('/palette/')}
              class="flex items-center justify-between rounded-lg px-3 py-2 text-xs font-medium text-indigo-300 hover:bg-indigo-500/10"
            >
              <span>GLSL Palette Manager</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </aside>

      <article class="min-w-0">
        <div class="space-y-8">
          <slot />
        </div>

        {(prevDoc || nextDoc) && (
          <div class="mt-12 grid gap-4 border-t border-slate-800/80 pt-6 sm:grid-cols-2">
            {prevDoc ? (
              <a
                href={withBase(prevDoc.href)}
                class="group rounded-xl border border-slate-800 bg-slate-900/40 p-4 transition hover:border-cyan-500/40"
              >
                <div class="text-xs text-slate-400">← Previous</div>
                <div class="mt-1 text-sm font-semibold text-slate-100 group-hover:text-cyan-300">
                  {prevDoc.title}
                </div>
              </a>
            ) : (
              <div />
            )}
            {nextDoc && (
              <a
                href={withBase(nextDoc.href)}
                class="group rounded-xl border border-slate-800 bg-slate-900/40 p-4 text-right transition hover:border-cyan-500/40"
              >
                <div class="text-xs text-slate-400">Next →</div>
                <div class="mt-1 text-sm font-semibold text-slate-100 group-hover:text-cyan-300">
                  {nextDoc.title}
                </div>
              </a>
            )}
          </div>
        )}
      </article>
    </div>
  </div>
</BaseLayout>
