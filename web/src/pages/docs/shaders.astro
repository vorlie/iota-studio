---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { withBase } from '../../lib/url';

const uniforms = [
  ['uniform sampler2D u_texture;', 'Bound TargetImage texture or captured canvas-below framebuffer (composition:0).'],
  ['uniform float u_time;', 'Elapsed visualizer time in seconds (continuous during playback and export).'],
  ['uniform vec2 u_resolution;', 'Active composition render target dimensions in pixels (width, height).'],
  ['uniform float u_beat;', 'Current beat detector envelope signal [0..1+].'],
  ['uniform vec4 u_soundKeys;', '(R1 = Bass, R2 = Mids, R3 = Highs, W = Beat) from the active SoundKeys layer.'],
];

const sampleShader = `#version 450 core

in vec2 v_uv;
in vec4 v_color;
out vec4 iota_FragColor;

uniform sampler2D u_texture;
uniform float u_time;
uniform vec2 u_resolution;
uniform float u_beat;
uniform vec4 u_soundKeys;

const vec3 CYAN = vec3(0.0800, 0.5800, 0.6800);

void main() {
  vec4 base = texture(u_texture, v_uv);
  float pulse = clamp(u_soundKeys.x * 0.65 + u_beat * 0.35, 0.0, 1.5);
  base.rgb += CYAN * pulse * 0.15;
  iota_FragColor = base * v_color;
}`;
---

<DocsLayout title="Custom GLSL 450 Shaders — Iota Studio Docs">
  <header>
    <div class="font-mono text-xs uppercase tracking-wider text-indigo-300">Shaders &amp; Palettes</div>
    <h1 class="mt-2 text-3xl font-bold text-white">Custom GLSL 450 Shaders</h1>
    <p class="mt-2 text-sm leading-relaxed text-slate-300">
      Write generator shaders or canvas-below Post-FX passes directly inside Iota Studio's live Shader Editor, backed by OpenGL 4.5 Core Profile.
    </p>
  </header>

  <section class="space-y-3">
    <h2 class="text-xl font-semibold text-white">Standard Uniforms</h2>
    <div class="divide-y divide-slate-800/80 rounded-xl border border-slate-800 bg-[#0d121c]">
      {
        uniforms.map(([sig, desc]) => (
          <div class="px-4 py-3">
            <code class="font-mono text-xs font-semibold text-cyan-200">{sig}</code>
            <p class="mt-1 text-xs text-slate-300">{desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-xl font-semibold text-white">Canvas-Below Post-FX (<code class="font-mono text-cyan-200">composition:0</code>)</h2>
    <p class="text-sm leading-relaxed text-slate-300">
      Set <code class="font-mono text-cyan-200">TargetImage</code> to <code class="font-mono text-cyan-200">composition:0</code> inside a composition to snapshot everything drawn below the <code class="font-mono">CustomShader</code> layer into <code class="font-mono">u_texture</code>—ideal for chromatic aberration, CRT scanlines, shockwaves, and film grain.
    </p>
    <p class="text-xs leading-relaxed text-slate-400">
      Legacy shaders without a <code class="font-mono">#version</code> directive (or using GLSL ES / 1.x headers) are automatically upgraded to <code class="font-mono">#version 450 core</code> (mapping <code class="font-mono">varying</code> → <code class="font-mono">in</code>, <code class="font-mono">texture2D</code> → <code class="font-mono">texture</code>, and <code class="font-mono">gl_FragColor</code> → <code class="font-mono">iota_FragColor</code>).
    </p>
  </section>

  <section class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xl font-semibold text-white">Starter Fragment Shader &amp; Palette Workflow</h2>
      <a href={withBase('/palette/')} class="text-xs font-medium text-indigo-300 hover:underline">
        Open GLSL Palette Manager →
      </a>
    </div>
    <p class="text-xs leading-relaxed text-slate-300">
      Top-of-file <code class="font-mono text-cyan-200">const vec3</code> declarations can be copied into the{' '}
      <a href={withBase('/palette/')} class="text-indigo-300 hover:underline">GLSL Palette Manager</a> (accessible inside Studio via{' '}
      <strong>Shader Editor → Options → Open GLSL Palette Manager (Web)...</strong>) to edit OKLab, linear RGB, or sRGB stops visually.
    </p>
    <pre class="overflow-x-auto rounded-xl border border-slate-800 bg-[#080b11] p-4 font-mono text-xs leading-relaxed text-slate-200"><code>{sampleShader}</code></pre>
  </section>
</DocsLayout>
