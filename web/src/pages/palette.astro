---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="GLSL Palette Manager — Iota Studio">
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="font-mono text-xs uppercase tracking-wider text-indigo-300">Web Tool · Shader Authoring</div>
        <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-white sm:text-3xl">GLSL Palette Manager</h1>
        <p class="mt-1.5 text-sm text-slate-300">
          Paste <code class="font-mono text-cyan-200">const vec3</code> declarations, tweak colors in OKLab, linear RGB, or sRGB, and copy formatted GLSL back into Iota Studio.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 text-xs">
        <button id="preset-default" type="button" class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-slate-200 hover:border-slate-500">
          Default Sample
        </button>
        <button id="preset-oklab" type="button" class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-slate-200 hover:border-slate-500">
          Fluid Gradient (OKLab)
        </button>
        <a href={withBase('/docs/shaders/')} class="rounded-lg border border-cyan-500/30 bg-cyan-500/10 px-3 py-1.5 text-cyan-200 hover:bg-cyan-500/20">
          Shader Guide →
        </a>
      </div>
    </div>

    <div class="mt-6 space-y-5">
      <section class="rounded-2xl border border-slate-800 bg-[#0d121c] p-5">
        <textarea
          id="src"
          spellcheck="false"
          placeholder="const vec3 BG = vec3(0.145, 0.035, -0.055);&#10;const vec3 CYAN = vec3(0.08, 0.58, 0.68);"
          class="min-h-[145px] w-full resize-y rounded-xl border border-slate-800 bg-[#080b11] p-3 font-mono text-xs leading-relaxed text-slate-100 focus:border-cyan-400/50 focus:outline-none"
        ></textarea>
        <div class="mt-3 flex flex-wrap items-center gap-2.5 text-xs">
          <label class="flex items-center gap-2 text-slate-300">
            <span>Pasted values are</span>
            <select id="lsp" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-slate-100">
              <option value="oklab">OKLab</option>
              <option value="linear">linear RGB</option>
              <option value="srgb">sRGB</option>
            </select>
          </label>
          <button
            id="parse"
            type="button"
            class="rounded-lg bg-indigo-500 px-3.5 py-1.5 font-semibold text-white transition hover:bg-indigo-400"
          >
            Load / replace palette
          </button>
          <button
            id="append"
            type="button"
            class="rounded-lg border border-slate-700 bg-slate-900 px-3.5 py-1.5 font-medium text-slate-200 hover:border-slate-500"
          >
            Append to palette
          </button>
          <span class="text-slate-400">Multi-line declarations and negative values are supported.</span>
        </div>
      </section>

      <section class="rounded-2xl border border-slate-800 bg-[#0d121c] p-5">
        <div class="mb-3 flex flex-wrap items-center gap-3 text-xs">
          <label class="flex items-center gap-2 text-slate-300">
            <span>Sliders range (RGB)</span>
            <select id="range" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-slate-100">
              <option value="1">-0.25 … 1</option>
              <option value="2">-0.5 … 2 (HDR)</option>
            </select>
          </label>
          <div class="flex-1"></div>
          <button
            id="add"
            type="button"
            class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 font-medium text-slate-100 hover:border-cyan-400/50"
          >
            + Add color
          </button>
        </div>

        <div id="strip" class="mb-3 h-11 rounded-xl border border-slate-800"></div>
        <div id="list" class="divide-y divide-slate-800/80"></div>

        <p class="mt-3 text-xs leading-relaxed text-slate-400">
          Each color keeps its own space (OKLab, linear RGB, or sRGB). OKLab colors preview clamped to the sRGB gamut and flag{' '}
          <span class="text-amber-300">out of gamut</span> when exceeded. Changing a color's space reinterprets its numbers, while the swatch picker converts into that color's space.
        </p>
      </section>

      <section class="rounded-2xl border border-slate-800 bg-[#0d121c] p-5">
        <div class="mb-3 flex flex-wrap items-center gap-3 text-xs">
          <label class="flex items-center gap-2 text-slate-300">
            <span>Format</span>
            <select id="fmt" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-slate-100">
              <option value="multi">Multi-line</option>
              <option value="aligned" selected>Aligned one-liners</option>
            </select>
          </label>
          <label class="flex items-center gap-2 text-slate-300">
            <span>Decimals</span>
            <select id="dec" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-slate-100">
              <option>3</option>
              <option selected>4</option>
              <option>6</option>
            </select>
          </label>
          <label class="flex items-center gap-2 text-slate-300">
            <span>Float suffix</span>
            <select id="suf" class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-slate-100">
              <option value="">none</option>
              <option value="f">f</option>
            </select>
          </label>
          <div class="flex-1"></div>
          <button
            id="copy"
            type="button"
            class="rounded-lg bg-cyan-400 px-4 py-1.5 font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            Copy GLSL
          </button>
        </div>
        <textarea
          id="out"
          readonly
          spellcheck="false"
          class="min-h-[135px] w-full resize-y rounded-xl border border-slate-800 bg-[#080b11] p-3 font-mono text-xs leading-relaxed text-cyan-100 focus:outline-none"
        ></textarea>
      </section>
    </div>
  </section>

  <script is:inline>
    (function () {
      var colors = [];
      var $ = function (i) { return document.getElementById(i); };
      var list = $('list');
      var strip = $('strip');
      var out = $('out');

      function labels(c) { return c.sp === 'oklab' ? ['L', 'a', 'b'] : ['r', 'g', 'b']; }
      function rng(c, j, lo, hi) { return c.sp === 'oklab' ? (j ? [-0.4, 0.4] : [0, 1]) : [lo, hi]; }

      function clamp(x) { return Math.min(1, Math.max(0, x)); }
      function enc(x) { x = clamp(x); return x <= 0.0031308 ? 12.92 * x : 1.055 * Math.pow(x, 1 / 2.4) - 0.055; }
      function dec(x) { return x <= 0.04045 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4); }

      function lin(c) {
        if (c.sp === 'linear') return c.v;
        if (c.sp === 'srgb') return c.v.map(dec);
        var L = c.v[0], a = c.v[1], b = c.v[2];
        var l = L + 0.3963377774 * a + 0.2158037573 * b;
        var m = L - 0.1055613458 * a - 0.0638541728 * b;
        var s = L - 0.0894841775 * a - 1.291485548 * b;
        l = l * l * l; m = m * m * m; s = s * s * s;
        return [
          4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
          -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
          -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
        ];
      }

      function srgbOf(c) { return c.sp === 'srgb' ? c.v.map(clamp) : lin(c).map(enc); }
      function hex(c) {
        return '#' + srgbOf(c).map(function (x) {
          var n = Math.round(x * 255);
          return (n < 16 ? '0' : '') + n.toString(16);
        }).join('');
      }

      function fromHex(h, sp) {
        var s = [1, 3, 5].map(function (i) { return parseInt(h.substr(i, 2), 16) / 255; });
        if (sp === 'srgb') return s;
        var r = s.map(dec);
        if (sp === 'linear') return r;
        var l = Math.cbrt(0.4122214708 * r[0] + 0.5363325363 * r[1] + 0.0514459929 * r[2]);
        var m = Math.cbrt(0.2119034982 * r[0] + 0.6806995451 * r[1] + 0.1073969566 * r[2]);
        var q = Math.cbrt(0.0883024619 * r[0] + 0.2817188376 * r[1] + 0.6299787005 * r[2]);
        return [
          0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * q,
          1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * q,
          0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * q,
        ];
      }

      function odd(c) { return lin(c).some(function (x) { return x < -0.0005 || x > 1.0005; }); }

      function parse(text, sp) {
        var re = /const\s+vec3\s+(\w+)\s*=\s*vec3\s*\(([^)]*)\)\s*;/g;
        var m, res = [];
        while ((m = re.exec(text))) {
          var p = m[2].split(',').map(function (s) { return parseFloat(s.replace(/f\s*$/i, '')); }).filter(function (n) { return !isNaN(n); });
          if (p.length === 1) p = [p[0], p[0], p[0]];
          if (p.length >= 3) res.push({ name: m[1], v: p.slice(0, 3), sp: sp });
        }
        return res;
      }

      function fmtNum(n, d, suf) {
        var s = n.toFixed(d);
        if (suf === 'f' && s.indexOf('.') < 0) s += '.0';
        return s + suf;
      }

      function exportGLSL() {
        var d = +$('dec').value, suf = $('suf').value, f = $('fmt').value;
        var pad = Math.max.apply(null, colors.map(function (c) { return c.name.length; }).concat([0]));
        out.value = colors.map(function (c) {
          var n = c.v.map(function (x) { return fmtNum(x, d, suf); });
          if (f === 'multi') {
            return 'const vec3 ' + c.name + ' = vec3(\n' + n.map(function (s, i) { return '    ' + s + (i < 2 ? ',' : ''); }).join('\n') + '\n);';
          }
          return 'const vec3 ' + (c.name + ' '.repeat(pad - c.name.length)) + ' = vec3(' + n.join(', ') + ');';
        }).join(f === 'multi' ? '\n\n' : '\n');
      }

      function refreshStrip() {
        if (!colors.length) { strip.style.background = 'transparent'; return; }
        var stops = colors.map(function (c, i) {
          var p = colors.length > 1 ? (i / (colors.length - 1) * 100) : 0;
          return hex(c) + ' ' + p + '%';
        });
        strip.style.background = colors.length > 1 ? 'linear-gradient(90deg,' + stops.join(',') + ')' : hex(colors[0]);
      }

      function refreshRow(i) {
        var c = colors[i], el = list.children[i];
        if (!el) return;
        var h = hex(c);
        el.querySelector('.sw').style.background = h;
        el.querySelector('input[type=color]').value = h;
        el.querySelector('.hex').textContent = h;
        el.querySelector('.badge').style.display = odd(c) ? 'inline-block' : 'none';
      }

      function refreshAll() {
        colors.forEach(function (_, i) { refreshRow(i); });
        refreshStrip();
        exportGLSL();
      }

      function syncInputs(row, c, skip) {
        row.querySelectorAll('.ch input').forEach(function (inp) {
          if (inp !== skip) inp.value = c.v[+inp.dataset.j];
        });
      }

      function render() {
        list.innerHTML = '';
        var lo = $('range').value === '2' ? -0.5 : -0.25;
        var hi = $('range').value === '2' ? 2 : 1;
        colors.forEach(function (c, i) {
          var row = document.createElement('div');
          row.className = 'grid grid-cols-[56px_1fr] gap-3 py-3';
          row.innerHTML =
            '<div class="sw relative h-14 w-14 cursor-pointer overflow-hidden rounded-xl border border-slate-700"><input type="color" class="absolute inset-0 h-full w-full cursor-pointer opacity-0"></div>' +
            '<div>' +
              '<div class="flex flex-wrap items-center gap-2">' +
                '<input class="name w-40 rounded-md border border-transparent bg-transparent px-1.5 py-0.5 font-mono text-xs font-semibold text-white focus:border-slate-700 focus:outline-none" spellcheck="false">' +
                '<select class="sp rounded-md border border-slate-700 bg-slate-900 px-2 py-0.5 text-xs text-slate-200"><option value="oklab">OKLab</option><option value="linear">linear</option><option value="srgb">sRGB</option></select>' +
                '<span class="hex font-mono text-xs text-slate-400"></span>' +
                '<span class="badge hidden rounded border border-amber-400/60 px-1.5 py-0.5 text-[10px] font-medium text-amber-300">out of gamut</span>' +
                '<button type="button" class="x ml-auto rounded-md border border-slate-700 bg-slate-900 px-2 py-0.5 text-xs text-slate-300 hover:border-rose-500/50 hover:text-rose-300" title="Remove">×</button>' +
              '</div>' +
              labels(c).map(function (k, j) {
                var r = rng(c, j, lo, hi);
                return '<div class="ch mt-1.5 grid grid-cols-[16px_1fr_84px] items-center gap-2">' +
                  '<span class="font-mono text-xs text-slate-400">' + k + '</span>' +
                  '<input type="range" class="w-full accent-indigo-400" data-j="' + j + '" min="' + r[0] + '" max="' + r[1] + '" step="0.001">' +
                  '<input type="number" class="w-[84px] rounded-md border border-slate-800 bg-[#080b11] px-2 py-1 font-mono text-xs text-slate-100" data-j="' + j + '" step="0.005">' +
                '</div>';
              }).join('') +
            '</div>';

          var nm = row.querySelector('.name'); nm.value = c.name;
          var sel = row.querySelector('.sp'); sel.value = c.sp;
          sel.onchange = function () { c.sp = sel.value; render(); };
          nm.oninput = function () { c.name = nm.value.replace(/\W/g, '_'); exportGLSL(); };
          row.querySelector('input[type=color]').oninput = function (e) {
            c.v = fromHex(e.target.value, c.sp).map(function (x) { return Math.round(x * 100000) / 100000; });
            syncInputs(row, c);
            refreshRow(i);
            refreshStrip();
            exportGLSL();
          };
          row.querySelectorAll('.ch input').forEach(function (inp) {
            inp.oninput = function () {
              var v = parseFloat(inp.value);
              if (isNaN(v)) return;
              c.v[+inp.dataset.j] = v;
              syncInputs(row, c, inp);
              refreshRow(i);
              refreshStrip();
              exportGLSL();
            };
          });
          row.querySelector('.x').onclick = function () { colors.splice(i, 1); render(); };
          list.appendChild(row);
          syncInputs(row, c);
        });
        refreshAll();
      }

      $('parse').onclick = function () {
        var r = parse($('src').value, $('lsp').value);
        if (r.length) { colors = r; render(); } else { alert('No const vec3 declarations found.'); }
      };
      $('append').onclick = function () {
        var r = parse($('src').value, $('lsp').value);
        if (r.length) { colors = colors.concat(r); render(); }
      };
      $('add').onclick = function () {
        var sp = $('lsp').value;
        colors.push({ name: 'COLOR' + colors.length, v: sp === 'oklab' ? [0.5, 0, 0] : [0.5, 0.5, 0.5], sp: sp });
        render();
      };
      $('range').onchange = render;
      ['fmt', 'dec', 'suf'].forEach(function (id) { $(id).onchange = exportGLSL; });
      $('copy').onclick = function () {
        var b = $('copy'), t = b.textContent;
        function ok() { b.textContent = 'Copied!'; setTimeout(function () { b.textContent = t; }, 1200); }
        out.select();
        try { navigator.clipboard.writeText(out.value).then(ok, function () { document.execCommand('copy'); ok(); }); }
        catch (e) { document.execCommand('copy'); ok(); }
      };

      function loadDefaultSample() {
        $('src').value = [
          'const vec3 BG = vec3(0.145000, 0.035000, -0.055000);',
          'const vec3 C0 = vec3(0.365000, 0.085000, -0.045000);',
          'const vec3 DEEP_BLUE = vec3(0.008, 0.018, 0.065);',
          'const vec3 CYAN      = vec3(0.08, 0.58, 0.68);',
          'const vec3 PINK      = vec3(0.65, 0.19, 0.42);',
          'const vec3 GOLD      = vec3(0.85, 0.52, 0.23);',
        ].join('\n');
        colors = parse($('src').value, 'linear');
        colors.forEach(function (c) { if (/^(BG|C\d)$/.test(c.name)) c.sp = 'oklab'; });
        render();
      }

      $('preset-default').onclick = loadDefaultSample;
      $('preset-oklab').onclick = function () {
        $('lsp').value = 'oklab';
        $('src').value = [
          'const vec3 C0 = vec3(0.2400, 0.0450, -0.0950);',
          'const vec3 C1 = vec3(0.5600, -0.0850, -0.0750);',
          'const vec3 C2 = vec3(0.6400, 0.1650, -0.0450);',
          'const vec3 C3 = vec3(0.8200, 0.0350, 0.1250);',
        ].join('\n');
        colors = parse($('src').value, 'oklab');
        render();
      };

      loadDefaultSample();
    })();
  </script>
</BaseLayout>
