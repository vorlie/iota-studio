{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-ninja-release",
      "displayName": "Windows MSVC x64 Ninja Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-ninja-debug",
      "displayName": "Windows MSVC x64 Ninja Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-ninja-release-mcp",
      "displayName": "Windows MSVC x64 Ninja Release (MCP Enabled)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "windows-msvc-ninja-debug-mcp",
      "displayName": "Windows MSVC x64 Ninja Debug (MCP Enabled)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "linux-gcc-ninja-release",
      "displayName": "Linux GCC Ninja Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-ninja-debug",
      "displayName": "Linux GCC Ninja Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-ninja-release-mcp",
      "displayName": "Linux GCC Ninja Release (MCP Enabled)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "linux-gcc-ninja-debug-mcp",
      "displayName": "Linux GCC Ninja Debug (MCP Enabled)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "wasm-emscripten-release",
      "displayName": "WebAssembly Emscripten Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IOTA_BUILD_TESTS": "OFF",
        "IOTA_BUILD_MCP": "OFF",
        "IOTA_ENABLE_DISCORD_RPC": "OFF",
        "IOTA_ENABLE_VIDEO_EXPORT": "OFF"
      }
    },
    {
      "name": "wasm-emscripten-debug",
      "displayName": "WebAssembly Emscripten Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm-debug",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "IOTA_BUILD_TESTS": "OFF",
        "IOTA_BUILD_MCP": "OFF",
        "IOTA_ENABLE_DISCORD_RPC": "OFF",
        "IOTA_ENABLE_VIDEO_EXPORT": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc-ninja-release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-msvc-ninja-debug"
    },
    {
      "name": "release-mcp",
      "configurePreset": "windows-msvc-ninja-release-mcp"
    },
    {
      "name": "debug-mcp",
      "configurePreset": "windows-msvc-ninja-debug-mcp"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-gcc-ninja-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-gcc-ninja-debug"
    },
    {
      "name": "linux-release-mcp",
      "configurePreset": "linux-gcc-ninja-release-mcp"
    },
    {
      "name": "linux-debug-mcp",
      "configurePreset": "linux-gcc-ninja-debug-mcp"
    },
    {
      "name": "wasm-emscripten-release",
      "configurePreset": "wasm-emscripten-release"
    },
    {
      "name": "wasm-emscripten-debug",
      "configurePreset": "wasm-emscripten-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc-ninja-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-mcp",
      "configurePreset": "windows-msvc-ninja-release-mcp",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-gcc-ninja-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release-mcp",
      "configurePreset": "linux-gcc-ninja-release-mcp",
      "output": { "outputOnFailure": true }
    }
  ]
}
