{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-ninja-release",
      "displayName": "Windows MSVC x64 Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-ninja-debug",
      "displayName": "Windows MSVC x64 Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-ninja-release-mcp",
      "displayName": "Windows MSVC x64 Ninja Release (MCP Enabled)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "windows-msvc-ninja-debug-mcp",
      "displayName": "Windows MSVC x64 Ninja Debug (MCP Enabled)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "linux-gcc-ninja-release",
      "displayName": "Linux GCC Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-ninja-debug",
      "displayName": "Linux GCC Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-ninja-release-mcp",
      "displayName": "Linux GCC Ninja Release (MCP Enabled)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "IOTA_BUILD_MCP": "ON"
      }
    },
    {
      "name": "linux-gcc-ninja-debug-mcp",
      "displayName": "Linux GCC Ninja Debug (MCP Enabled)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug-mcp",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "IOTA_BUILD_MCP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc-ninja-release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-msvc-ninja-debug"
    },
    {
      "name": "release-mcp",
      "configurePreset": "windows-msvc-ninja-release-mcp"
    },
    {
      "name": "debug-mcp",
      "configurePreset": "windows-msvc-ninja-debug-mcp"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-gcc-ninja-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-gcc-ninja-debug"
    },
    {
      "name": "linux-release-mcp",
      "configurePreset": "linux-gcc-ninja-release-mcp"
    },
    {
      "name": "linux-debug-mcp",
      "configurePreset": "linux-gcc-ninja-debug-mcp"
    }
  ]
}
